# Supabase (set these to your instance's values)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# For schema apply only (optional):
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Crawler behaviour
RUN_ON_START=1
CRAWL_CONCURRENCY=3
CRAWL_TIMEOUT=60000
CRAWL_HEADFUL=0
STORE_RAW_HTML=0
PORT=8080