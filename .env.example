# Supabase (set these to your instance's values)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# For schema apply only (optional):
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Crawler behaviour
RUN_ON_START=1
CRAWL_CONCURRENCY=5
CRAWL_DELAY=500
CRAWL_TIMEOUT=60000
CRAWL_MAX=0
# Daily scheduled crawl time in HH:MM (UTC). Default 18:00 UTC = 21:00 EET (after BVB close).
CRAWL_TIME=18:00
STORE_RAW_HTML=0
PORT=8080